server {
    listen 80;
    root /usr/share/nginx/html;

    location / {
        add_header Cache-Control "no-cache";
        # tout est servi par nous : aucun script, style ni connexion externe, aucun script ou style en ligne
        add_header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'";
        add_header X-Content-Type-Options "nosniff";
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
    }

    # SSE : pas de tampon, connexion longue
    location /api/events {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
