# Modèle du Secret (volontairement sans extension .yaml : `kubectl apply -f k8s/` ne le lit pas
# et n'écrase donc jamais le vrai Secret). Création avec la clé de .env :
#   kubectl create secret generic cadiou-desk --from-env-file=.env
apiVersion: v1
kind: Secret
metadata:
  name: cadiou-desk
stringData:
  DESK_KEY: change-me
